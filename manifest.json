{
  "manifest_version": 3,
  "name": "Kinopoisk → Kinokino",
  "version": "1.1.0",
  "description": "Добавляет кнопку перехода на Kinokino на страницах Кинопоиска.",
  "host_permissions": [
    "https://www.kinopoisk.ru/*",
    "https://brogiro.cfd/*"
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Настройки Kinokino",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kinopoisk.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
